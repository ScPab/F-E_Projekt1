# Beispiel-Umgebungsvariablen für DataBridge. Für lokale Entwicklung nach
# ".env" kopieren und bei Bedarf anpassen. ".env" wird nicht versioniert.

# --- Mediator ---
MEDIATOR_PORT=8000

# --- Wrapper: GDC (Genomic Data Commons / TCGA) ---
GDC_API_BASE_URL=https://api.gdc.cancer.gov

# --- Wrapper: GEO / ENA / cBioPortal ---
# Nur bei Bedarf setzen (z. B. Mirror/Proxy) — Defaults im Mediator sind
# bereits die jeweiligen offiziellen Basis-URLs (mediator/app/main.py).
# GEO_API_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# ENA_API_BASE_URL=https://www.ebi.ac.uk/ena/portal/api
# CBIOPORTAL_API_BASE_URL=https://www.cbioportal.org/api

# Cache-Verzeichnis für die drei Cache-Tiers (Recipes/Materialized/Raw),
# siehe wrappers/gdc/cache.py. Gilt pro Wrapper, nicht nur für GDC.
DATABRIDGE_CACHE_DIR=.cache/databridge

# Zielverzeichnis für POST /export/anndata (siehe app/semantic/paths.py).
# Ohne Angabe: mediator/scripts/output/anndata (lokal) bzw. containerintern
# relativ dazu — nur bei Bedarf überschreiben (z. B. Volume-Mount für
# persistente Exporte).
# DATABRIDGE_EXPORT_DIR=./mediator/scripts/output/anndata

# --- Mediator: Wissensnetz-Ontologie (Semantic ETL, POST /transform) ---
# Verzeichnis mit databridge-core.ttl + alignment/, siehe
# wissensnetz/ontology/README.md und mediator/app/semantic/paths.py.
# Im Container per COPY/Bind-Mount auf /ontology gesetzt (siehe
# mediator/Dockerfile, docker-compose.yml); außerhalb von Docker fällt der
# Code automatisch auf wissensnetz/ontology relativ zum Repo zurück, diese
# Variable ist daher für lokale Entwicklung nur bei Bedarf zu setzen.
DATABRIDGE_ONTOLOGY_DIR=./wissensnetz/ontology

# --- graph-db (aktuell Platzhalter: Apache Jena Fuseki/TDB2) ---
# Beim Austausch gegen eine Property-Graph-DB (z. B. JanusGraph/Memgraph)
# diese Variablen an das jeweilige Zielsystem anpassen.
GRAPH_DB_PORT=3030
GRAPH_DB_DATASET=databridge

# Vom Wissensnetz-Client (Paket wissensnetz/) gelesen. Innerhalb von Compose
# spricht der Client den Service über GRAPH_DB_URL=http://graph-db:3030 an;
# außerhalb (lokale Entwicklung/Tests) wird ohne GRAPH_DB_URL aus Host/Port
# http://localhost:${GRAPH_DB_PORT} gebildet — diese Variable ist daher nur bei
# Bedarf zu setzen. Das Admin-Passwort muss zu ADMIN_PASSWORD des graph-db-
# Containers passen (docker-compose.yml) und wird für Schreibzugriffe
# (SPARQL Update / Graph Store Protocol) benötigt.
# GRAPH_DB_URL=http://localhost:3030
GRAPH_DB_ADMIN_USER=admin
GRAPH_DB_ADMIN_PASSWORD=admin
