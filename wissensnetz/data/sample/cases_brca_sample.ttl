    db:ageAtDiagnosis 21200 ;
    db:describesCase <http://databridge.hka/instance/case/11111111-1111-4111-8111-111111111111> ;
    db:primaryDiagnosisLabel "Infiltrating duct carcinoma, NOS"^^xsd:string .

