# RDF-star: Provenienz & Konfidenz für Alignment-Aussagen
# (siehe wissensnetz/Mapping-Konzept_GDC-zu-RDF-OWL, Abschnitt 4; ADR-0002)
@prefix gdc: <http://databridge.hka/source/gdc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<< <http://databridge.hka/instance/diagnosis/d-11111111> <http://databridge.hka/onto#primaryDiagnosis> <http://purl.obolibrary.org/obo/NCIT_C4194> >>
    prov:wasDerivedFrom gdc:submission ;
    db:confidence 1.0 .

