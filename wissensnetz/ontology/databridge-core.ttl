@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ncit: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix db: <http://databridge.hka/onto#> .

# DataBridge Core Ontology (TBox) — erster Ausschnitt: case/project/demographic/
# diagnosis. Setzt die Konstrukt-für-Konstrukt-Mapping-Tabelle aus
# wissensnetz/Mapping-Konzept_GDC-zu-RDF-OWL um:
#   node                  -> owl:Class
#   property + type       -> owl:DatatypeProperty (xsd-Range)
#   link + target_type    -> owl:ObjectProperty
#   backref                -> owl:inverseOf
#   enum-Werte             -> Alignment auf externe Bio-Ontologien (hier: NCIt),
#                              siehe alignment/ncit_primary_diagnosis.json
#   required: [...]        -> owl:minCardinality 1 + rdfs:domain
#   title / description    -> rdfs:label / rdfs:comment
#
# Erweiterung für neue Klassen/Properties/Quellen: siehe /docs/adding_new_sources.md.

<http://databridge.hka/onto> a owl:Ontology ;
    rdfs:label "DataBridge Core Ontology" ;
    rdfs:comment "Quellen-unabhängige Zielontologie des DataBridge-Wissensnetzes. Erster Ausschnitt aus dem GDC-Datenmodell (case/project/demographic/diagnosis)." .

# ---------------------------------------------------------------------------
# Klassen
# ---------------------------------------------------------------------------

db:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "Entspricht GDC-Node 'project': ein Forschungsprojekt/Kohorte, z. B. TCGA-BRCA." .

db:Case a owl:Class ;
    rdfs:label "Case" ;
    rdfs:comment "Entspricht GDC-Node 'case': ein einzelner Patient/Fall innerhalb eines Projekts." .

db:Demographic a owl:Class ;
    rdfs:label "Demographic" ;
    rdfs:comment "Entspricht GDC-Node 'demographic': demografische Angaben zu einem Case." .

db:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis" ;
    rdfs:comment "Text term for histologic diagnosis (GDC-Node 'diagnosis')." .

db:Sample a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:comment "Entspricht GDC-Node 'sample': ein Biospecimen/Probe eines Case (z. B. Primary Tumor, Solid Tissue Normal)." .

# ---------------------------------------------------------------------------
# Object Properties (links + backref -> owl:inverseOf)
# ---------------------------------------------------------------------------

db:belongsToProject a owl:ObjectProperty ;
    rdfs:label "belongsToProject" ;
    rdfs:domain db:Case ;
    rdfs:range db:Project ;
    owl:inverseOf db:hasCase .

db:hasCase a owl:ObjectProperty ;
    rdfs:label "hasCase" ;
    rdfs:domain db:Project ;
    rdfs:range db:Case .

db:hasDemographic a owl:ObjectProperty ;
    rdfs:label "hasDemographic" ;
    rdfs:domain db:Case ;
    rdfs:range db:Demographic ;
    owl:inverseOf db:isDemographicOf .

db:isDemographicOf a owl:ObjectProperty ;
    rdfs:label "isDemographicOf" ;
    rdfs:domain db:Demographic ;
    rdfs:range db:Case .

# link: samples (Case -> Sample), backref: case (Sample -> Case) — analog zu
# hasDemographic/isDemographicOf.
db:hasSample a owl:ObjectProperty ;
    rdfs:label "hasSample" ;
    rdfs:domain db:Case ;
    rdfs:range db:Sample ;
    owl:inverseOf db:isSampleOf .

db:isSampleOf a owl:ObjectProperty ;
    rdfs:label "isSampleOf" ;
    rdfs:domain db:Sample ;
    rdfs:range db:Case .

# link: cases (Diagnosis -> Case), backref: diagnoses (Case -> Diagnosis) —
# Namen exakt wie im Beispiel aus wissensnetz/Mapping-Konzept_GDC-zu-RDF-OWL.
db:describesCase a owl:ObjectProperty ;
    rdfs:label "describesCase" ;
    rdfs:domain db:Diagnosis ;
    rdfs:range db:Case ;
    owl:inverseOf db:hasDiagnosis .

db:hasDiagnosis a owl:ObjectProperty ;
    rdfs:label "hasDiagnosis" ;
    rdfs:domain db:Case ;
    rdfs:range db:Diagnosis .

# enum-Wert primary_diagnosis, sofern in der Alignment-Tabelle vorhanden
# (siehe alignment/ncit_primary_diagnosis.json). Range ncit:Neoplasm ist ein
# symbolischer Platzhalter aus dem Mapping-Konzept-Beispiel — der exakte
# NCIt-Code für den Range ist noch mit dem Wissensnetz-Teilbereich (Marcel)
# abzustimmen.
db:primaryDiagnosis a owl:ObjectProperty ;
    rdfs:label "primaryDiagnosis" ;
    rdfs:comment "Alignment des GDC-enum-Werts 'primary_diagnosis' auf einen NCIt-Konzept-Individual, siehe alignment/ncit_primary_diagnosis.json." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range ncit:Neoplasm .

# ---------------------------------------------------------------------------
# Datatype Properties
# ---------------------------------------------------------------------------

db:projectId a owl:DatatypeProperty ;
    rdfs:label "projectId" ;
    rdfs:domain db:Project ;
    rdfs:range xsd:string .

db:caseId a owl:DatatypeProperty ;
    rdfs:label "caseId" ;
    rdfs:domain db:Case ;
    rdfs:range xsd:string .

db:submitterId a owl:DatatypeProperty ;
    rdfs:label "submitterId" ;
    rdfs:domain db:Case ;
    rdfs:range xsd:string .

db:gender a owl:DatatypeProperty ;
    rdfs:label "gender" ;
    rdfs:domain db:Demographic ;
    rdfs:range xsd:string .

# Roh-/Fallback-Text für primary_diagnosis (immer gesetzt, unabhängig davon,
# ob ein Alignment auf db:primaryDiagnosis existiert — deckt Marcels
# Empfehlung "Alignment für die klinisch zentralen Felder, literal für den
# Rest" auf Feld-Ebene ab).
db:primaryDiagnosisLabel a owl:DatatypeProperty ;
    rdfs:label "primaryDiagnosisLabel" ;
    rdfs:comment "Text term for histologic diagnosis, wie von GDC geliefert (Rohtext, kein Alignment)." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:string .

db:ageAtDiagnosis a owl:DatatypeProperty ;
    rdfs:label "ageAtDiagnosis" ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:integer .

# Weitere Demographic-Felder aus dem GDC-'demographic'-Node (Rohtext, kein
# Alignment) — für die vollständige Oviedo-MP-Feldliste (Hover in MP-lite).
db:race a owl:DatatypeProperty ;
    rdfs:label "race" ;
    rdfs:comment "Race des Case, wie von GDC geliefert (demographic.race)." ;
    rdfs:domain db:Demographic ;
    rdfs:range xsd:string .

db:ethnicity a owl:DatatypeProperty ;
    rdfs:label "ethnicity" ;
    rdfs:comment "Ethnicity des Case, wie von GDC geliefert (demographic.ethnicity)." ;
    rdfs:domain db:Demographic ;
    rdfs:range xsd:string .

db:vitalStatus a owl:DatatypeProperty ;
    rdfs:label "vitalStatus" ;
    rdfs:comment "Vital status des Case, wie von GDC geliefert (demographic.vital_status)." ;
    rdfs:domain db:Demographic ;
    rdfs:range xsd:string .

# Weitere Diagnosis-Felder aus dem GDC-'diagnosis'-Node (Rohtext, kein
# Alignment) — für die vollständige Oviedo-MP-Feldliste (Hover in MP-lite).
db:tumorStage a owl:DatatypeProperty ;
    rdfs:label "tumorStage" ;
    rdfs:comment "Tumor-Stadium der Diagnose, wie von GDC geliefert (diagnoses.ajcc_pathologic_stage bzw. tumor_stage)." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:string .

db:morphology a owl:DatatypeProperty ;
    rdfs:label "morphology" ;
    rdfs:comment "Morphologie-Code der Diagnose, wie von GDC geliefert (diagnoses.morphology)." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:string .

db:siteOfResectionOrBiopsy a owl:DatatypeProperty ;
    rdfs:label "siteOfResectionOrBiopsy" ;
    rdfs:comment "Ort der Resektion/Biopsie der Diagnose, wie von GDC geliefert (diagnoses.site_of_resection_or_biopsy)." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:string .

db:metastasisAtDiagnosis a owl:DatatypeProperty ;
    rdfs:label "metastasisAtDiagnosis" ;
    rdfs:comment "Metastasierung bei Diagnosestellung, wie von GDC geliefert (diagnoses.metastasis_at_diagnosis)." ;
    rdfs:domain db:Diagnosis ;
    rdfs:range xsd:string .

# Sample-Typ aus dem GDC-'sample'-Node (Rohtext, kein Alignment) — trägt die
# Oviedo-Hover-Spalte 'type' (z. B. "Primary Tumor" / "Solid Tissue Normal").
db:sampleType a owl:DatatypeProperty ;
    rdfs:label "sampleType" ;
    rdfs:comment "Sample-/Biospecimen-Typ, wie von GDC geliefert (samples.sample_type)." ;
    rdfs:domain db:Sample ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Erweiterung: GEO, ENA, cBioPortal (siehe mediator/app/semantic/mapping_geo.py,
# mapping_ena.py, mapping_cbioportal.py sowie docs/adding_new_sources.md).
#
# Wiederverwendung statt Duplikat, wo das Konzept wirklich übereinstimmt:
#   - cBioPortal-Studien/-Patienten/-Proben nutzen die bestehenden Klassen
#     db:Project/db:Case/db:Sample (cBioPortal bereitet häufig dieselben
#     TCGA/GDC-Ursprungsdaten auf, siehe wrappers/cbioportal/client.py).
#   - GEO-Series und ENA-Runs teilen sich db:Run (ein einzelner
#     experimenteller Lauf/Sample innerhalb einer Serie/Studie) sowie
#     db:organism, db:hasRun/db:isRunOf — dieselbe Rolle, unabhängig davon,
#     ob die Elternklasse db:Series (GEO) oder db:Study (ENA) heißt.
#   - GEO-Series und ENA-Studien bleiben bewusst EIGENE Klassen (db:Series/
#     db:Study) statt in db:Project hineingezwungen zu werden — anders als
#     bei cBioPortal ist die Identifikator-/Feld-Semantik hier zu
#     unterschiedlich (GSE-Accession + Organismus/Plattform-Metadaten vs.
#     TCGA-Projekt-Code). Spätere Konsolidierung (gemeinsame Oberklasse für
#     "benannter Container mit Proben") ist eine bewusst offen gelassene
#     Ontologie-Entscheidung, keine implizite hier.
# ---------------------------------------------------------------------------

db:Series a owl:Class ;
    rdfs:label "Series" ;
    rdfs:comment "Entspricht einer GEO-Series (GSE): eine benannte Sammlung zusammengehöriger Experiment-Samples." .

db:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:comment "Entspricht einer ENA/SRA-Study (Project): eine benannte Sammlung zusammengehöriger Sequenzierläufe." .

db:Run a owl:Class ;
    rdfs:label "Run" ;
    rdfs:comment "Ein einzelner experimenteller Lauf/Sample innerhalb einer Series (GEO) oder Study (ENA)." .

# link: Series/Study -> Run, backref: Run -> Series/Study. Domain bewusst
# NICHT auf eine einzelne Klasse eingeschränkt (rdfs:domain wäre bei zwei
# Elternklassen als Konjunktion falsch, nicht als Disjunktion) — siehe
# Kommentar oben.
db:hasRun a owl:ObjectProperty ;
    rdfs:label "hasRun" ;
    rdfs:range db:Run ;
    owl:inverseOf db:isRunOf .

db:isRunOf a owl:ObjectProperty ;
    rdfs:label "isRunOf" ;
    rdfs:domain db:Run .

db:seriesId a owl:DatatypeProperty ;
    rdfs:label "seriesId" ;
    rdfs:comment "GEO-Series-Accession, z. B. 'GSE345780' (esummary-Feld 'accession')." ;
    rdfs:domain db:Series ;
    rdfs:range xsd:string .

db:studyId a owl:DatatypeProperty ;
    rdfs:label "studyId" ;
    rdfs:comment "ENA/SRA-Study-Accession, z. B. 'PRJEB1234' (Feld 'study_accession')." ;
    rdfs:domain db:Study ;
    rdfs:range xsd:string .

db:runId a owl:DatatypeProperty ;
    rdfs:label "runId" ;
    rdfs:comment "GEO-GSM- bzw. ENA-Run-Accession (Feld 'accession' bzw. 'run_accession')." ;
    rdfs:domain db:Run ;
    rdfs:range xsd:string .

# Wiederverwendbar über Series/Run (GEO: 'taxon'/'scientific_name' bei ENA).
db:organism a owl:DatatypeProperty ;
    rdfs:label "organism" ;
    rdfs:comment "Taxonomischer Organismus, wie von der Quelle geliefert (GEO 'taxon', ENA 'scientific_name')." ;
    rdfs:range xsd:string .

db:experimentType a owl:DatatypeProperty ;
    rdfs:label "experimentType" ;
    rdfs:comment "Experiment-/Datentyp einer GEO-Series (Feld 'gdstype', z. B. 'Expression profiling by high throughput sequencing')." ;
    rdfs:domain db:Series ;
    rdfs:range xsd:string .

db:releaseDate a owl:DatatypeProperty ;
    rdfs:label "releaseDate" ;
    rdfs:comment "Veröffentlichungsdatum einer GEO-Series, Rohtext wie von GEO geliefert (Feld 'pdat', kein ISO-8601 garantiert)." ;
    rdfs:domain db:Series ;
    rdfs:range xsd:string .

db:ftpLink a owl:DatatypeProperty ;
    rdfs:label "ftpLink" ;
    rdfs:comment "FTP-/HTTPS-Verzeichnislink für Rohdaten einer GEO-Series (Feld 'ftplink')." ;
    rdfs:domain db:Series ;
    rdfs:range xsd:anyURI .

# Wiederverwendbar über Series/Project (GEO 'n_samples', cBioPortal 'allSampleCount').
db:sampleCount a owl:DatatypeProperty ;
    rdfs:label "sampleCount" ;
    rdfs:comment "Anzahl zugehöriger Samples, wie von der Quelle geliefert." ;
    rdfs:range xsd:integer .

db:libraryStrategy a owl:DatatypeProperty ;
    rdfs:label "libraryStrategy" ;
    rdfs:comment "Sequenzier-/Bibliotheksstrategie eines ENA-Runs (Feld 'library_strategy', z. B. 'RNA-Seq')." ;
    rdfs:domain db:Run ;
    rdfs:range xsd:string .

db:instrumentPlatform a owl:DatatypeProperty ;
    rdfs:label "instrumentPlatform" ;
    rdfs:comment "Sequenzier-Plattform eines ENA-Runs (Feld 'instrument_platform', z. B. 'ILLUMINA')." ;
    rdfs:domain db:Run ;
    rdfs:range xsd:string .

db:readCount a owl:DatatypeProperty ;
    rdfs:label "readCount" ;
    rdfs:comment "Anzahl Reads eines ENA-Runs (Feld 'read_count')." ;
    rdfs:domain db:Run ;
    rdfs:range xsd:integer .

# Neue, cBioPortal-spezifische Properties auf wiederverwendeten Klassen
# (db:Project/db:Case, siehe Wiederverwendungs-Hinweis oben).
db:age a owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:comment "Alter des Patienten, wie von cBioPortal geliefert (clinicalAttributeId 'AGE') — anders als db:ageAtDiagnosis (GDC) nicht zwingend auf ein Diagnose-Ereignis bezogen." ;
    rdfs:domain db:Case ;
    rdfs:range xsd:integer .

db:cancerType a owl:DatatypeProperty ;
    rdfs:label "cancerType" ;
    rdfs:comment "Krebsart-Kürzel einer cBioPortal-Studie (Feld 'cancerTypeId')." ;
    rdfs:domain db:Project ;
    rdfs:range xsd:string .

db:oncotreeCode a owl:DatatypeProperty ;
    rdfs:label "oncotreeCode" ;
    rdfs:comment "OncoTree-Klassifikationscode einer Probe, wie von cBioPortal geliefert (clinicalAttributeId 'ONCOTREE_CODE')." ;
    rdfs:domain db:Sample ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# Cardinality-Restriktion (required: [primary_diagnosis] im GDC-Schema)
# ---------------------------------------------------------------------------

db:Diagnosis rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty db:primaryDiagnosisLabel ;
    owl:minCardinality 1
] .
